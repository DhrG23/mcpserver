# Caddy running DIRECTLY on the host (no Docker), proxying to the Python server on localhost.
# Run:  SERVER_HOST=192.168.1.20 caddy run --config docker/Caddyfile.host
# Use https://<SERVER_HOST>:8443 as the server address in the app.
# Clients that connect by IP address (curl, the Node app) send no server name in the TLS handshake.
# Behind Docker's port forwarding Caddy cannot guess the right certificate, so name it explicitly.
{
    default_sni {$SERVER_HOST}
}

https://{$SERVER_HOST}:8443 {
    tls internal
    handle /mcp* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /chat/* {
        reverse_proxy 127.0.0.1:8001 {
            stream_close_delay 5m
        }
    }
    handle /auth/* {
        reverse_proxy 127.0.0.1:8001
    }
    handle /account/* {
        reverse_proxy 127.0.0.1:8001
    }
    handle /heartbeat {
        reverse_proxy 127.0.0.1:8001
    }
    handle /devices* {
        reverse_proxy 127.0.0.1:8001
    }
    handle /approvals* {
        reverse_proxy 127.0.0.1:8001
    }
    handle /healthz {
        reverse_proxy 127.0.0.1:8001
    }
}
