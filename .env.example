# Copy to .env and fill in. Never commit the real .env.

# Bearer tokens that identify each caller to the permissions layer.
# Generate real random values for anything beyond local dev, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ALEXA_TOKEN=dev-alexa-token
NEMOTRON_TOKEN=dev-nemotron-token
OLLAMA_TOKEN=dev-ollama-token
ADMIN_TOKEN=dev-admin-token

# At-rest encryption key for memory values and device telemetry (screenshots,
# notifications, location). REQUIRED for real use -- without it the server
# generates a throwaway key each restart and your data becomes unreadable.
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Web search (search_web tool).
# duckduckgo = free, no key, no cost -> good default, especially for your
#   own daily-use instance and the Amazon/Alexa+ build.
# tavily     = needs TAVILY_API_KEY below (free tier at https://tavily.com).
#   Worth switching to this specifically for the Nebius submission: there's
#   a standalone "Best Use of Tavily" prize there, and it returns a
#   synthesized `answer` field that can help the Nemotron agent chain tools.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Ports (defaults shown; only change if you know why)
MCP_PORT=8000
GATEWAY_PORT=8001
