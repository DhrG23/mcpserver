# Copy this file to agent.env and replace the token and MCP host.
MCP_URL=https://127.0.0.1:8443/mcp
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TOKEN=dev-ollama-token

# Set false only when diagnosing an untrusted local Caddy certificate on a
# trusted LAN. Keep true when the local CA is installed correctly.
MCP_VERIFY_TLS=true
MAX_TOOL_ROUNDS=8
OLLAMA_THINK=true